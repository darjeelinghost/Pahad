            document.getElementById('addParticipantForm').addEventListener('submit', (e) => {
                e.preventDefault();
                const regId = document.getElementById('newPartRegId').value.trim();
                const name = document.getElementById('newPartName').value.trim();
                if (!regId || !name) return;

                const hexBlock = () => Math.floor(0x1000 + Math.random() * 0xEFFF).toString(16).toUpperCase();
                const digitalId = `DIG-${hexBlock()}-${hexBlock()}-${hexBlock()}`;

                approvedParticipants.push({ regId, name, digitalId });
                document.getElementById('newPartRegId').value = '';
                document.getElementById('newPartName').value = '';
                renderRosterUI();
                showToast(`Added ${name} (${regId}) to participant roster.`);
            });

            renderRosterUI();

            // --- Deterministic Hash & QR Matrix Generator for Digital Encoding Look ---
            function computeDigitalHash(seedStr) {
                let h1 = 0xdeadbeef, h2 = 0x41c6ce57;
                for (let i = 0; i < seedStr.length; i++) {
                    const ch = seedStr.charCodeAt(i);
                    h1 = Math.imul(h1 ^ ch, 2654435761);
                    h2 = Math.imul(h2 ^ ch, 1597334677);
                }
                h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
                h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
                const hex1 = (h1 >>> 0).toString(16).toUpperCase().padStart(8, '0');
                const hex2 = (h2 >>> 0).toString(16).toUpperCase().padStart(8, '0');
                return `${hex1}${hex2}${hex1.split('').reverse().join('')}`;
            }

            function renderDigitalQrMatrix(seedStr, fillColor) {
                const svg = document.getElementById('digitalQrSvg');
                if (!svg) return;
                const size = 21;
                let rects = '';

                const isFinder = (r, c) => {
                    const inBox = (tr, tc) => r >= tr && r < tr + 7 && c >= tc && c < tc + 7;
                    return inBox(0, 0) || inBox(0, size - 7) || inBox(size - 7, 0);
                };

                const drawFinder = (tr, tc) => {
                    rects += `<rect x="${tc}" y="${tr}" width="7" height="7" fill="none" stroke="${fillColor}" stroke-width="1"/>`;
                    rects += `<rect x="${tc + 2}" y="${tr + 2}" width="3" height="3" fill="${fillColor}"/>`;
                };

                drawFinder(0.5, 0.5);
                drawFinder(0.5, size - 6.5);
                drawFinder(size - 6.5, 0.5);

                let hash = 2166136261;
                for (let i = 0; i < seedStr.length; i++) {
                    hash ^= seedStr.charCodeAt(i);
                    hash = Math.imul(hash, 16777619);
                }

                for (let r = 0; r < size; r++) {
                    for (let c = 0; c < size; c++) {
                        if (isFinder(r, c)) continue;
                        if (r === 6 || c === 6) {
                            if ((r + c) % 2 === 0) {
                                rects += `<rect x="${c}" y="${r}" width="1" height="1" fill="${fillColor}"/>`;
                            }
                            continue;
                        }
                        hash = (Math.imul(hash ^ (r * 31 + c), 1664525) + 1013904223) >>> 0;
                        if ((hash & 1) === 1) {
                            rects += `<rect x="${c}" y="${r}" width="1" height="1" fill="${fillColor}"/>`;
                        }
                    }
                }
                svg.innerHTML = rects;
            }

            // --- Render Certificate Live ---
