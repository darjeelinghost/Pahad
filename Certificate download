<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PAHAD CREDENTIAL STUDIO</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts for authentic certificate typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Great+Vibes&family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
    <!-- FontAwesome for crisp icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- html2canvas & jsPDF for high-res PNG/PDF export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        cinzel: ['Cinzel', 'serif'],
                        script: ['Great Vibes', 'cursive'],
                        montserrat: ['Montserrat', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- Top Navigation Bar -->
    <header class="bg-white border-b border-slate-200 px-4 sm:px-6 py-3.5 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-full overflow-hidden shadow-sm shrink-0">
                    <!-- PAHAD Circular Brand Logo -->
                    <svg viewBox="0 0 120 120" class="w-full h-full">
                        <circle cx="60" cy="60" r="60" fill="#1A464E"/>
                        <circle cx="60" cy="60" r="50" fill="#F2865E"/>
                        <polygon points="14,88 54,28 84,74 92,62 110,88" fill="#1A464E"/>
                        <polygon points="54,28 43,46 53,43 60,51 67,44" fill="#F7F5EE"/>
                        <polygon points="54,28 60,51 74,72 62,74" fill="#4A777A"/>
                        <path d="M12,78 A50,50 0 0,0 108,78 Z" fill="#1A464E"/>
                        <text x="60" y="92" text-anchor="middle" font-family="Montserrat, sans-serif" font-weight="800" font-size="16" letter-spacing="1" fill="#F7F5EE">PAHAD</text>
                    </svg>
                </div>
                <div>
                    <h1 class="text-base sm:text-lg font-bold tracking-wide text-[#1A464E] leading-none">PAHAD CREDENTIAL STUDIO</h1>
                    <p class="text-xs text-slate-500 mt-0.5">People. Knowledge. Action.</p>
                </div>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
                <button id="btnAdminRoster" type="button" class="px-3 py-2 text-xs sm:text-sm font-medium text-slate-700 bg-amber-50 hover:bg-amber-100 border border-amber-200 rounded-lg transition-colors flex items-center gap-1.5">
                    <i class="fa-solid fa-users-gear text-amber-700"></i>
                    <span class="hidden sm:inline">Participant Roster</span>
                </button>
                <button id="btnLockPortal" type="button" class="px-3 py-2 text-xs sm:text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors flex items-center gap-1.5" title="Lock & Switch Participant">
                    <i class="fa-solid fa-lock"></i>
                    <span class="hidden sm:inline">Verify ID</span>
                </button>
                <button id="btnReset" type="button" class="px-3 py-2 text-xs sm:text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors flex items-center gap-1.5">
                    <i class="fa-solid fa-rotate-left"></i>
                    <span class="hidden sm:inline">Reset</span>
                </button>
                <button id="btnDownloadPNG" type="button" disabled class="px-3.5 py-2 text-xs sm:text-sm font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 rounded-lg transition-colors flex items-center gap-1.5 disabled:opacity-40 disabled:cursor-not-allowed">
                    <i class="fa-solid fa-image"></i>
                    <span>PNG</span>
                </button>
                <button id="btnDownloadPDF" type="button" disabled class="px-4 py-2 text-xs sm:text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-colors flex items-center gap-1.5 disabled:opacity-40 disabled:cursor-not-allowed">
                    <i class="fa-solid fa-file-pdf"></i>
                    <span>Download PDF</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Participant Verification Gate Modal -->
    <div id="participantGateModal" class="fixed inset-0 z-50 bg-slate-900/75 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-5">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full overflow-hidden shrink-0 shadow-sm">
                    <!-- PAHAD Circular Brand Logo -->
                    <svg viewBox="0 0 120 120" class="w-full h-full">
                        <circle cx="60" cy="60" r="60" fill="#1A464E"/>
                        <circle cx="60" cy="60" r="50" fill="#F2865E"/>
                        <polygon points="14,88 54,28 84,74 92,62 110,88" fill="#1A464E"/>
                        <polygon points="54,28 43,46 53,43 60,51 67,44" fill="#F7F5EE"/>
                        <polygon points="54,28 60,51 74,72 62,74" fill="#4A777A"/>
                        <path d="M12,78 A50,50 0 0,0 108,78 Z" fill="#1A464E"/>
                        <text x="60" y="92" text-anchor="middle" font-family="Montserrat, sans-serif" font-weight="800" font-size="16" letter-spacing="1" fill="#F7F5EE">PAHAD</text>
                    </svg>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Participant Access Only</h2>
                    <p class="text-xs text-slate-500">PAHAD CREDENTIAL STUDIO Verification</p>
                </div>
            </div>

            <p class="text-sm text-slate-600 leading-relaxed">
                This certificate is exclusively available to registered event participants. Enter your <strong>Registration ID</strong> or <strong>Full Name</strong> to verify and claim your certificate.
            </p>

            <form id="verifyParticipantForm" class="space-y-3.5">
                <div>
                    <label for="gateRegIdInput" class="block text-xs font-semibold text-slate-700 mb-1">Participant Registration ID</label>
                    <input type="text" id="gateRegIdInput" placeholder="e.g., Reg10" required class="w-full px-3.5 py-2.5 text-sm font-mono border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#1A464E]">
                </div>
                <div>
                    <label for="gateNameInput" class="block text-xs font-semibold text-slate-700 mb-1">Registered Full Name</label>
                    <input type="text" id="gateNameInput" placeholder="e.g., Sibath Rai" required class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#1A464E]">
                </div>

                <div id="gateErrorBox" class="hidden text-xs text-rose-700 bg-rose-50 border border-rose-200 rounded-lg px-3 py-2 flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span id="gateErrorText">Participant ID and Name do not match our official roster.</span>
                </div>

                <button type="submit" class="w-full py-2.5 px-4 bg-[#1A464E] hover:bg-[#14353b] text-white text-sm font-semibold rounded-xl shadow-sm transition-colors flex items-center justify-center gap-2">
                    <i class="fa-solid fa-shield-check"></i>
                    <span>Verify & Unlock Certificate</span>
                </button>
            </form>

            <!-- Sample Participant Quick-Fill for Testing -->
            <div class="pt-3 border-t border-slate-100">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-2">Sample Registered Participants (Click to Test)</p>
                <div id="sampleParticipantPills" class="flex flex-wrap gap-1.5"></div>
            </div>
        </div>
    </div>

    <!-- Admin Participant Roster Modal -->
    <div id="rosterModal" class="hidden fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-base font-bold text-slate-900">Approved Participant Roster</h2>
                    <p class="text-xs text-slate-500">Only listed participants can unlock and download certificates.</p>
                </div>
                <button type="button" id="btnCloseRoster" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="addParticipantForm" class="grid grid-cols-1 sm:grid-cols-5 gap-2">
                <input type="text" id="newPartRegId" placeholder="REG-PAHAD-2026-..." required class="sm:col-span-2 px-3 py-2 text-xs font-mono border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#1A464E]">
                <input type="text" id="newPartName" placeholder="Participant Full Name" required class="sm:col-span-2 px-3 py-2 text-xs border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#1A464E]">
                <button type="submit" class="px-3 py-2 bg-[#1A464E] hover:bg-[#14353b] text-white text-xs font-semibold rounded-lg">Add</button>
            </form>

            <div id="rosterListContainer" class="max-h-56 overflow-y-auto divide-y divide-slate-100 border border-slate-200 rounded-xl"></div>
        </div>
    </div>

    <!-- Admin Roster PIN Lock Modal -->
    <div id="rosterPinModal" class="hidden fixed inset-0 z-50 bg-slate-900/75 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-xs w-full p-6 shadow-2xl border border-slate-200 space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center">
                        <i class="fa-solid fa-key text-sm"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">Admin Access</h3>
                        <p class="text-[11px] text-slate-500">Enter Roster Passcode</p>
                    </div>
                </div>
                <button type="button" id="btnCloseRosterPin" class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>

            <form id="rosterPinForm" class="space-y-3">
                <input type="password" id="rosterPinInput" inputmode="numeric" maxlength="12" placeholder="Enter PIN" required class="w-full px-3.5 py-2.5 text-center text-base font-mono tracking-[0.35em] border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#1A464E]">
                <div id="rosterPinError" class="hidden text-xs text-rose-700 bg-rose-50 border border-rose-200 rounded-lg px-3 py-1.5 text-center">
                    Incorrect admin PIN.
                </div>
                <button type="submit" class="w-full py-2 px-4 bg-[#1A464E] hover:bg-[#14353b] text-white text-xs font-semibold rounded-xl transition-colors">
                    Unlock Roster
                </button>
            </form>
        </div>
    </div>

    <!-- Main Studio Layout -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Left Sidebar: Customization Controls -->
        <aside class="lg:col-span-4 bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-6">
            
            <!-- Template & Accent Selector -->
            <div>
                <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">1. Design & Theme</h2>
                
                <label class="block text-sm font-medium text-slate-700 mb-1.5">Template Style</label>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4" id="templateSelector">
                    <button type="button" data-template="pahad" class="template-btn active ring-2 ring-indigo-600 bg-indigo-50/50 border border-indigo-200 rounded-xl p-2 text-center transition-all">
                        <div class="text-xs font-semibold text-slate-800">Pahad</div>
                        <div class="text-[10px] text-slate-500 mt-0.5">Alpine Peaks</div>
                    </button>
                    <button type="button" data-template="classic" class="template-btn border border-slate-200 hover:border-slate-300 rounded-xl p-2 text-center transition-all">
                        <div class="text-xs font-semibold text-slate-800">Classic Gold</div>
                        <div class="text-[10px] text-slate-500 mt-0.5">Ornate Border</div>
                    </button>
                    <button type="button" data-template="modern" class="template-btn border border-slate-200 hover:border-slate-300 rounded-xl p-2 text-center transition-all">
                        <div class="text-xs font-semibold text-slate-800">Modern</div>
                        <div class="text-[10px] text-slate-500 mt-0.5">Clean & Bold</div>
                    </button>
                    <button type="button" data-template="executive" class="template-btn border border-slate-200 hover:border-slate-300 rounded-xl p-2 text-center transition-all">
                        <div class="text-xs font-semibold text-slate-800">Executive</div>
                        <div class="text-[10px] text-slate-500 mt-0.5">Dark Slate</div>
                    </button>
                </div>

                <label class="block text-sm font-medium text-slate-700 mb-1.5">Accent Color</label>
                <div class="flex items-center gap-2.5" id="colorPalette">
                    <button type="button" data-color="#1A464E" class="color-swatch w-7 h-7 rounded-full bg-[#1A464E] ring-2 ring-offset-2 ring-[#1A464E] transition-transform scale-110" title="PAHAD Deep Teal (Primary)"></button>
                    <button type="button" data-color="#F2865E" class="color-swatch w-7 h-7 rounded-full bg-[#F2865E] hover:scale-110 transition-transform" title="Himalayan Sunset Coral"></button>
                    <button type="button" data-color="#4A777A" class="color-swatch w-7 h-7 rounded-full bg-[#4A777A] hover:scale-110 transition-transform" title="Glacial Ridge Teal"></button>
                    <button type="button" data-color="#2D5A5E" class="color-swatch w-7 h-7 rounded-full bg-[#2D5A5E] hover:scale-110 transition-transform" title="Darjeeling Pine"></button>
                    <button type="button" data-color="#D97706" class="color-swatch w-7 h-7 rounded-full bg-amber-600 hover:scale-110 transition-transform" title="Sunrise Gold"></button>
                    <button type="button" data-color="#1E3A8A" class="color-swatch w-7 h-7 rounded-full bg-blue-900 hover:scale-110 transition-transform" title="Alpine Sky"></button>
                </div>
            </div>

            <hr class="border-slate-100">

            <!-- Certificate Details Form -->
            <div class="space-y-4">
                <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">2. Certificate Details</h2>

                <div>
                    <label for="inputRecipient" class="block text-xs font-semibold text-slate-700 mb-1">Recipient Full Name <span class="text-[10px] text-emerald-700 font-normal">(Verified Participant)</span></label>
                    <input type="text" id="inputRecipient" value="Sibath Rai" readonly class="w-full px-3 py-2 text-sm font-medium bg-slate-50 text-slate-600 border border-slate-200 rounded-lg cursor-not-allowed">
                </div>

                <div>
                    <label for="inputOrg" class="block text-xs font-semibold text-slate-700 mb-1">Issuing Organization</label>
                    <input type="text" id="inputOrg" value="PAHAD COMMUNITY ORGANISATION" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <div>
                    <label for="inputTitle" class="block text-xs font-semibold text-slate-700 mb-1">Certificate Title</label>
                    <input type="text" id="inputTitle" value="CERTIFICATE OF APPRECIATION" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <div>
                    <label for="inputSubtitle" class="block text-xs font-semibold text-slate-700 mb-1">Introductory Line</label>
                    <input type="text" id="inputSubtitle" value="THIS IS PROUDLY PRESENTED TO" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <div>
                    <label for="inputDescription" class="block text-xs font-semibold text-slate-700 mb-1">Achievement Description</label>
                    <textarea id="inputDescription" rows="3" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">In recognition of meaningful contribution to Participatory Action for Holistic Advancement & Development across the Darjeeling & Kalimpong hills, the Terai, the Dooars and the wider Himalaya.</textarea>
                </div>

                <div>
                    <label for="inputDate" class="block text-xs font-semibold text-slate-700 mb-1">Issue Date</label>
                    <input type="text" id="inputDate" value="November 17, 2026" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label for="inputRegId" class="block text-xs font-semibold text-slate-700 mb-1">Registration ID <span class="text-[10px] text-emerald-700 font-normal">(Locked)</span></label>
                        <input type="text" id="inputRegId" value="Reg10" readonly class="w-full px-2.5 py-2 text-xs font-mono bg-slate-50 text-slate-600 border border-slate-200 rounded-lg cursor-not-allowed">
                    </div>
                    <div>
                        <label for="inputDigitalId" class="block text-xs font-semibold text-slate-700 mb-1">Digital ID</label>
                        <input type="text" id="inputDigitalId" value="DIG-9F3A-8492-BC10" readonly class="w-full px-2.5 py-2 text-xs font-mono bg-slate-50 text-slate-600 border border-slate-200 rounded-lg cursor-not-allowed">
                    </div>
                </div>
            </div>

            <hr class="border-slate-100">

            <!-- Signatories & Seal -->
            <div class="space-y-4">
                <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">3. Signatories & Seal</h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label for="inputSign1Name" class="block text-xs font-semibold text-slate-700 mb-1">Signatory 1 Name</label>
                        <input type="text" id="inputSign1Name" value="Shiwath Rai" class="w-full px-3 py-1.5 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label for="inputSign1Title" class="block text-xs font-semibold text-slate-700 mb-1">Signatory 1 Role</label>
                        <input type="text" id="inputSign1Title" value="President" class="w-full px-3 py-1.5 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label for="inputSign2Name" class="block text-xs font-semibold text-slate-700 mb-1">Signatory 2 Name</label>
                        <input type="text" id="inputSign2Name" value="Avineet Pradhan" class="w-full px-3 py-1.5 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label for="inputSign2Title" class="block text-xs font-semibold text-slate-700 mb-1">Signatory 2 Role</label>
                        <input type="text" id="inputSign2Title" value="General Secretary" class="w-full px-3 py-1.5 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                </div>

                <div class="flex items-center justify-between pt-1">
                    <span class="text-xs font-semibold text-slate-700">Show Official Gold Seal</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="toggleSeal" checked class="sr-only peer">
                        <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600"></div>
                    </label>
                </div>
            </div>
        </aside>

        <!-- Right Workspace: Live Scalable Certificate Preview -->
        <section class="lg:col-span-8 flex flex-col items-center">
            <div class="w-full flex items-center justify-between mb-3 px-1">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    Live Landscape Preview (A4 Ratio)
                </span>
                <span class="text-xs text-slate-400">High-Res Print Ready (300 DPI)</span>
            </div>

            <!-- Responsive Wrapper that dynamically scales the fixed 1000x707 certificate canvas -->
            <div id="previewContainer" class="w-full overflow-hidden rounded-2xl shadow-xl border border-slate-200/80 bg-slate-200/50 relative">
                
                <!-- Locked Overlay inside Preview when Unverified -->
                <div id="previewLockOverlay" class="absolute inset-0 z-30 bg-slate-900/60 backdrop-blur-md flex flex-col items-center justify-center text-white p-6 text-center">
                    <div class="w-14 h-14 rounded-full bg-white/10 border border-white/20 flex items-center justify-center mb-3">
                        <i class="fa-solid fa-lock text-2xl text-amber-300"></i>
                    </div>
                    <h3 class="text-lg font-bold">Participant Verification Required</h3>
                    <p class="text-xs text-slate-200 max-w-sm mt-1 mb-4">Only verified participants from the PAHAD roster can view and download this certificate.</p>
                    <button type="button" id="btnOpenGateFromPreview" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold rounded-lg shadow transition-colors">
                        Enter Participant ID
                    </button>
                </div>

                <!-- Actual Certificate Canvas (Fixed logical dimensions 1000x707 for consistent PDF/PNG export) -->
                <div id="certificateCanvas" class="w-[1000px] h-[707px] bg-white absolute top-0 left-0 select-none overflow-hidden transition-colors duration-300 origin-top-left blur-sm">
                    <!-- Dynamic Decorative Background Layer -->
                    <div id="certBgDecor" class="absolute inset-0 pointer-events-none"></div>

                    <!-- Digital Security Watermark & Cryptographic Hash Watermark -->
                    <div id="digitalSecurityWatermark" class="absolute inset-8 pointer-events-none overflow-hidden opacity-[0.045] flex flex-col justify-between font-mono text-[8px] leading-tight tracking-widest select-none">
                        <div class="whitespace-nowrap">PAHAD-CRYPTO-VERIFY // SHA256:8F94E2C1B7A04D39E5F128C6A90B3D74 // DIGITAL-CREDENTIAL-LEDGER // HIMALAYA-NODE-01</div>
                        <div class="whitespace-nowrap">01010000 01000001 01001000 01000001 01000100 // VERIFIED-CREDENTIAL-TOKEN // INTEGRITY-CHECK-PASSED</div>
