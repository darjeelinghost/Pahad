                const fullHash = computeDigitalHash(`${state.recipient}|${state.regId}|${state.digitalId}|${state.date}`);
                document.getElementById('dispTopHash').textContent = `SHA-256: ${fullHash.slice(0, 8)}...${fullHash.slice(-6)}`;
                document.getElementById('dispChecksum').textContent = `0x${fullHash.slice(0, 8)}`;
                renderDigitalQrMatrix(`${state.regId}-${state.digitalId}-${state.recipient}`, state.template === 'executive' ? '#fbbf24' : state.accentColor);

                document.getElementById('dispSign1Name').textContent = state.sign1Name || '';
                document.getElementById('dispSign1Script').textContent = state.sign1Name || '';
