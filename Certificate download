                };
                Object.entries(defaults).forEach(([id, val]) => {
                    const el = document.getElementById(id);
                    if (el) el.value = val;
                    state[inputMap[id]] = val;
                });
                state.showSeal = true;
                document.getElementById('toggleSeal').checked = true;
                renderCertificate();
                showToast('Certificate reset to default values.');
            });

            // --- High-Resolution Export Logic (PNG & PDF) ---
            async function captureHighResCanvas() {
                // Temporarily remove CSS scale transform so html2canvas captures exact 1000x707 dimensions cleanly
                const prevTransform = canvas.style.transform;
                canvas.style.transform = 'none';

                try {
                    const renderedCanvas = await html2canvas(canvas, {
                        scale: 2.5, // High resolution for crisp printing
                        useCORS: true,
                        backgroundColor: null,
                        width: 1000,
                        height: 707
                    });
                    return renderedCanvas;
                } finally {
                    // Restore responsive preview scale immediately
                    canvas.style.transform = prevTransform;
                }
            }

            // Export as PNG
            document.getElementById('btnDownloadPNG').addEventListener('click', async () => {
                if (!state.isVerified) {
                    showToast('Access denied: Participant verification required.');
                    return;
                }
                showToast('Generating high-resolution PNG...');
                try {
                    const renderedCanvas = await captureHighResCanvas();
                    const link = document.createElement('a');
                    const safeName = (state.recipient || 'Certificate').replace(/[^a-z0-9]/gi, '_');
                    link.download = `${safeName}_Certificate.png`;
                    link.href = renderedCanvas.toDataURL('image/png');
                    link.click();
                    showToast('PNG downloaded successfully!');
                } catch (err) {
                    console.error(err);
                    showToast('Error exporting PNG. Please try again.');
                }
            });

            // Export as Landscape PDF
            document.getElementById('btnDownloadPDF').addEventListener('click', async () => {
                if (!state.isVerified) {
                    showToast('Access denied: Participant verification required.');
                    return;
                }
                showToast('Generating print-ready PDF...');
                try {
                    const renderedCanvas = await captureHighResCanvas();
                    const imgData = renderedCanvas.toDataURL('image/png');
                    const { jsPDF } = window.jspdf;
                    
                    // A4 Landscape dimensions in mm: 297 x 210
                    const pdf = new jsPDF({
                        orientation: 'landscape',
                        unit: 'mm',
                        format: 'a4'
                    });

                    pdf.addImage(imgData, 'PNG', 0, 0, 297, 210);
                    const safeName = (state.recipient || 'Certificate').replace(/[^a-z0-9]/gi, '_');
                    pdf.save(`${safeName}_Certificate.pdf`);
                    showToast('PDF downloaded successfully!');
                } catch (err) {
                    console.error(err);
                    showToast('Error exporting PDF. Please try again.');
                }
            });

            // Initial render
            renderCertificate();
        });
    </script>
