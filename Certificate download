                    recipientEl.style.color = '#ffffff';
                    descEl.style.color = '#cbd5e1';
                    sign1ScriptEl.style.color = '#f8fafc';
                    sign1NameEl.style.color = '#f8fafc';
                    sign1TitleEl.style.color = '#94a3b8';
                    sign2ScriptEl.style.color = '#f8fafc';
                    sign2NameEl.style.color = '#f8fafc';
                    sign2TitleEl.style.color = '#94a3b8';
                    dateEl.style.color = '#f1f5f9';
                    regIdEl.style.color = '#f1f5f9';
                    digitalIdEl.style.color = '#f1f5f9';
