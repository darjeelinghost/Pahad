                subtitleEl.style.color = '#64748b';
                recipientEl.style.color = '#0f172a';
                descEl.style.color = '#334155';
                sign1ScriptEl.style.color = '#1e293b';
                sign1NameEl.style.color = '#1e293b';
                sign1TitleEl.style.color = '#64748b';
                sign2ScriptEl.style.color = '#1e293b';
                sign2NameEl.style.color = '#1e293b';
                sign2TitleEl.style.color = '#64748b';
                dateEl.style.color = '#1e293b';
                regIdEl.style.color = '#1e293b';
                digitalIdEl.style.color = '#1e293b';
                metaBar.style.color = '#475569';
                metaBar.style.borderColor = 'rgba(100, 116, 139, 0.25)';

                if (state.template === 'pahad') {
                    bgDecor.innerHTML = `
                        <svg viewBox="0 0 1000 707" class="w-full h-full preserve-3d" preserveAspectRatio="none">
                            <polygon points="0,635 190,545 365,610 530,520 740,605 1000,535 1000,707 0,707" fill="#A2BAB7" opacity="0.45"/>
                            <polygon points="0,665 165,585 335,645 495,570 695,645 860,575 1000,635 1000,707 0,707" fill="${state.accentColor}" opacity="0.16"/>
