                document.getElementById('dispSign2Name').textContent = state.sign2Name || '';
                document.getElementById('dispSign2Script').textContent = state.sign2Name || '';
                document.getElementById('dispSign2Title').textContent = state.sign2Title || '';

                const sealEl = document.getElementById('officialSeal');
                sealEl.style.display = state.showSeal ? 'flex' : 'none';

                const bgDecor = document.getElementById('certBgDecor');
                const outerFrame = document.getElementById('certOuterFrame');
                const innerFrame = document.getElementById('certInnerFrame');
                const corners = document.getElementById('cornerOrnaments');
                const titleEl = document.getElementById('dispTitle');
