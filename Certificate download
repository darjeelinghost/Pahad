            // Admin Roster Modal Controls (PIN Protected: 9582)
            const ROSTER_ADMIN_PIN = '9582';
            const rosterModal = document.getElementById('rosterModal');
            const rosterPinModal = document.getElementById('rosterPinModal');
            const rosterPinInput = document.getElementById('rosterPinInput');
            const rosterPinError = document.getElementById('rosterPinError');

