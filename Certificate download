                    const pill = document.createElement('button');
                    pill.type = 'button';
                    pill.className = 'text-[11px] px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-[#1A464E] hover:text-white text-slate-700 font-medium transition-colors';
                    pill.textContent = `${p.name} (${p.regId})`;
                    pill.addEventListener('click', () => {
                        document.getElementById('gateRegIdInput').value = p.regId;
                        document.getElementById('gateNameInput').value = p.name;
                        document.getElementById('gateErrorBox').classList.add('hidden');
                    });
                    pillsContainer.appendChild(pill);

                    // Admin Roster row
                    const row = document.createElement('div');
                    row.className = 'flex items-center justify-between px-3.5 py-2.5 text-xs';
                    row.innerHTML = `
                        <div>
                            <div class="font-semibold text-slate-800">${p.name}</div>
                            <div class="font-mono text-[11px] text-slate-500">${p.regId} • ${p.digitalId}</div>
                        </div>
                        <button type="button" data-idx="${idx}" class="remove-part-btn text-rose-600 hover:text-rose-800 px-2 py-1 rounded hover:bg-rose-50" title="Remove Participant">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    `;
                    rosterList.appendChild(row);
                });

                document.querySelectorAll('.remove-part-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const index = parseInt(btn.dataset.idx, 10);
                        if (approvedParticipants.length <= 1) {
                            showToast('At least one participant must remain in the roster.');
                            return;
                        }
                        approvedParticipants.splice(index, 1);
                        renderRosterUI();
                        showToast('Participant removed from roster.');
                    });
                });
            }

            document.getElementById('verifyParticipantForm').addEventListener('submit', (e) => {
                e.preventDefault();
                const enteredId = document.getElementById('gateRegIdInput').value.trim().toUpperCase();
                const enteredName = document.getElementById('gateNameInput').value.trim().toLowerCase();
                const errorBox = document.getElementById('gateErrorBox');

                const matched = approvedParticipants.find(p =>
                    p.regId.toUpperCase() === enteredId && p.name.toLowerCase() === enteredName
