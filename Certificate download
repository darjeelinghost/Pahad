                    topRibbon.style.backgroundColor = 'rgba(255, 255, 255, 0.06)';
                    topRibbon.style.borderColor = 'rgba(251, 191, 36, 0.35)';
                    topRibbon.style.color = '#fbbf24';
                    qrBox.style.backgroundColor = 'rgba(15, 23, 42, 0.9)';
                    qrBox.style.borderColor = 'rgba(251, 191, 36, 0.45)';
                    metaBar.style.color = '#94a3b8';
                    metaBar.style.borderColor = 'rgba(148, 163, 184, 0.25)';
                }
            }

            // --- Event Listeners for Inputs ---
            Object.entries(inputMap).forEach(([inputId, stateKey]) => {
                const el = document.getElementById(inputId);
                if (el) {
                    el.addEventListener('input', (e) => {
                        state[stateKey] = e.target.value;
                        renderCertificate();
                    });
                }
            });

            // Seal Toggle
            document.getElementById('toggleSeal').addEventListener('change', (e) => {
                state.showSeal = e.target.checked;
                renderCertificate();
            });

            // Template Selector Buttons
            document.querySelectorAll('.template-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.template-btn').forEach(b => {
                        b.classList.remove('active', 'ring-2', 'ring-indigo-600', 'bg-indigo-50/50', 'border-indigo-200');
                        b.classList.add('border-slate-200');
                    });
                    btn.classList.add('active', 'ring-2', 'ring-indigo-600', 'bg-indigo-50/50', 'border-indigo-200');
                    btn.classList.remove('border-slate-200');

                    state.template = btn.dataset.template;
                    renderCertificate();
                });
            });

            // Accent Color Swatches
            document.querySelectorAll('.color-swatch').forEach(swatch => {
                swatch.addEventListener('click', () => {
                    document.querySelectorAll('.color-swatch').forEach(s => {
                        s.classList.remove('ring-2', 'ring-offset-2', 'scale-110');
                        s.style.removeProperty('--tw-ring-color');
                    });
                    swatch.classList.add('ring-2', 'ring-offset-2', 'scale-110');
                    swatch.style.setProperty('--tw-ring-color', swatch.dataset.color);

                    state.accentColor = swatch.dataset.color;
                    renderCertificate();
                });
