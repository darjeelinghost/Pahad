                previewContainer.style.height = `${707 * scale}px`;
            }

            window.addEventListener('resize', updatePreviewScale);
            updatePreviewScale();

            // --- Toast Notification Helper ---
            let toastTimeout;
            function showToast(msg) {
                toastMessage.textContent = msg;
                toastBanner.classList.remove('translate-y-20', 'opacity-0');
                clearTimeout(toastTimeout);
                toastTimeout = setTimeout(() => {
                    toastBanner.classList.add('translate-y-20', 'opacity-0');
                }, 3000);
            }

            // --- Normalize Google Drive Sharing Links to Direct Image URLs ---
            function normalizeLogoUrl(url) {
                const trimmed = (url || '').trim();
                if (!trimmed) return '';
                const driveMatch = trimmed.match(/\/file\/d\/([a-zA-Z0-9_-]+)/) || trimmed.match(/[?&]id=([a-zA-Z0-9_-]+)/);
                if (driveMatch && driveMatch[1]) {
                    return `https://lh3.googleusercontent.com/d/${driveMatch[1]}`;
                }
                return trimmed;
            }

            // --- Extract Dominant Brand Color from Logo Image ---
            function extractBrandColors(imgEl, autoApply = true) {
                try {
                    const tempCanvas = document.createElement('canvas');
                    const ctx = tempCanvas.getContext('2d');
                    const w = 64, h = 64;
                    tempCanvas.width = w;
                    tempCanvas.height = h;
                    ctx.drawImage(imgEl, 0, 0, w, h);
                    const data = ctx.getImageData(0, 0, w, h).data;

                    const buckets = {};
                    for (let i = 0; i < data.length; i += 4) {
                        const r = data[i], g = data[i + 1], b = data[i + 2], a = data[i + 3];
                        if (a < 128) continue;
                        const max = Math.max(r, g, b), min = Math.min(r, g, b);
                        if (max > 240 && min > 235) continue;
                        if (max < 25) continue;

                        const qr = Math.round(r / 24) * 24;
                        const qg = Math.round(g / 24) * 24;
                        const qb = Math.round(b / 24) * 24;
                        const sat = max === 0 ? 0 : (max - min) / max;
                        const key = `${qr},${qg},${qb}`;
                        buckets[key] = (buckets[key] || 0) + (1 + sat * 3);
                    }

                    const sorted = Object.entries(buckets).sort((a, b) => b[1] - a[1]);
                    if (sorted.length > 0) {
                        const [r, g, b] = sorted[0][0].split(',').map(Number);
                        const hex = '#' + [r, g, b].map(v => Math.min(255, v).toString(16).padStart(2, '0')).join('');

                        const palette = document.getElementById('colorPalette');
                        let brandSwatch = document.getElementById('brandDetectedSwatch');
                        if (!brandSwatch) {
                            brandSwatch = document.createElement('button');
                            brandSwatch.id = 'brandDetectedSwatch';
                            brandSwatch.type = 'button';
                            brandSwatch.className = 'color-swatch w-7 h-7 rounded-full transition-transform hover:scale-110 border border-slate-300';
                            brandSwatch.title = 'Detected Logo Brand Color';
                            brandSwatch.addEventListener('click', () => {
                                document.querySelectorAll('.color-swatch').forEach(s => {
                                    s.classList.remove('ring-2', 'ring-offset-2', 'scale-110');
                                    s.style.removeProperty('--tw-ring-color');
                                });
                                brandSwatch.classList.add('ring-2', 'ring-offset-2', 'scale-110');
                                brandSwatch.style.setProperty('--tw-ring-color', brandSwatch.dataset.color);
                                state.accentColor = brandSwatch.dataset.color;
                                renderCertificate();
                            });
                            palette.prepend(brandSwatch);
                        }
                        brandSwatch.dataset.color = hex;
                        brandSwatch.style.backgroundColor = hex;

                        if (autoApply) {
                            brandSwatch.click();
                            showToast(`Adapted theme to logo brand color (${hex.toUpperCase()})`);
                        }
                    }
                } catch (e) {
                    // Cross-origin fallback handled gracefully
                }
            }

            // --- Participant Verification & Roster Logic ---
            const gateModal = document.getElementById('participantGateModal');
            const previewLockOverlay = document.getElementById('previewLockOverlay');
            const btnDownloadPNG = document.getElementById('btnDownloadPNG');
            const btnDownloadPDF = document.getElementById('btnDownloadPDF');

            function setVerificationState(verified, participant = null) {
                state.isVerified = verified;
                if (verified && participant) {
                    state.recipient = participant.name;
                    state.regId = participant.regId;
                    state.digitalId = participant.digitalId;

                    document.getElementById('inputRecipient').value = participant.name;
                    document.getElementById('inputRegId').value = participant.regId;
                    document.getElementById('inputDigitalId').value = participant.digitalId;

                    gateModal.classList.add('hidden');
                    previewLockOverlay.classList.add('hidden');
                    canvas.classList.remove('blur-sm');
                    btnDownloadPNG.disabled = false;
                    btnDownloadPDF.disabled = false;
                    renderCertificate();
                    showToast(`Verified participant: ${participant.name}`);
                } else {
                    gateModal.classList.remove('hidden');
                    previewLockOverlay.classList.remove('hidden');
                    canvas.classList.add('blur-sm');
                    btnDownloadPNG.disabled = true;
                    btnDownloadPDF.disabled = true;
                }
            }

            function renderRosterUI() {
                const pillsContainer = document.getElementById('sampleParticipantPills');
                const rosterList = document.getElementById('rosterListContainer');
                pillsContainer.innerHTML = '';
                rosterList.innerHTML = '';

                approvedParticipants.forEach((p, idx) => {
